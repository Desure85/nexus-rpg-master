# ======================== Nexus RPG — переменные окружения ========================

# --- Безопасность ---
# Ключ шифрования секретов (ключи ИИ пространств). Обязателен в проде; не меняйте после запуска.
# Сгенерировать: openssl rand -hex 32. Если пусто — создаётся data/secret.key.
APP_SECRET=
# Кто администратор платформы (через запятую). Если пусто — первый зарегистрированный.
SUPERADMIN_EMAILS=
# Регистрация мастеров: open | invite | closed
REGISTRATION=open
# Принудительно Secure-cookie (по умолчанию — если запрос пришёл по HTTPS)
COOKIE_SECURE=

# --- Дисклеймер ---
# Дополнение к стандартному дисклеймеру (контакты, возрастные ограничения) и ссылка на условия
DISCLAIMER_EXTRA=
TERMS_URL=

# --- Почта (восстановление пароля) ---
# Например smtps://user:pass@smtp.yandex.ru:465. Без неё ссылку сброса выдаёт админ платформы.
SMTP_URL=
MAIL_FROM=Nexus RPG <no-reply@example.com>

# --- Тарифы и оплата ---
# none | yookassa | mock (mock — оплата одним кликом для разработки)
PAYMENTS_PROVIDER=none
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек по 54-ФЗ через онлайн-кассу ЮKassa
YOOKASSA_RECEIPT=false
YOOKASSA_VAT_CODE=1
# Приветственные кредиты новому пространству и лимит сессий на бесплатном тарифе
FREE_CREDITS=50
FREE_MAX_SESSIONS=10
# 1 кредит = CREDIT_TOKENS «взвешенных» токенов; вывод дороже ввода в OUTPUT_WEIGHT раз
CREDIT_TOKENS=1000
OUTPUT_WEIGHT=4
# Свои продукты (JSON-массив {id, kind: pack|subscription, title, description, credits, price, currency, days})
BILLING_PRODUCTS=
# Разрешить пространствам свой URL модели (только self-host: иначе риск SSRF)
ALLOW_BYOK_CUSTOM_URL=false

# --- ИИ-провайдер ---
# gemini | openrouter | opencode | local | mock. Если задан — перекрывает выбор в настройках.
LLM_PROVIDER=
# Провайдер по умолчанию, если в настройках ещё ничего не выбрано
DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENCODE_API_KEY=
OPENCODE_API_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash
# OpenAI-совместимый сервер (Ollama, LM Studio, vLLM...). Запросы идут С СЕРВЕРА игры.
LOCAL_MODEL_URL=http://localhost:11434/v1
LOCAL_MODEL_KEY=
LOCAL_MODEL_NAME=llama3.1
# Сколько ждать ответа модели, мс
LLM_TIMEOUT_MS=180000

# --- Сервер ---
PORT=3000
DB_PATH=./data/game.db
# За реверс-прокси (nginx, Caddy, Cloudflare) — чтобы лимиты считались по реальному IP
TRUST_PROXY=false
# Публичный адрес (return_url оплаты, заголовки OpenRouter)
APP_URL=
# Лимиты: ходов/генераций в минуту с одного IP и новых сессий в час
RATE_LIMIT_PER_MIN=30
SESSIONS_PER_HOUR=30
