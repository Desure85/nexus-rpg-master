# ======================== Nexus RPG — переменные окружения ========================

# --- Доступ ---
# Токен администратора: без него ЛЮБОЙ посетитель может менять модель ИИ и читать логи.
# Для публичного сервера обязателен. Вводится в «Настройки → Доступ».
ADMIN_TOKEN=
# Код мастера: если задан, создавать игры (и тратить ИИ-бюджет) можно только с этим кодом.
# Игрокам, заходящим по ссылкам, код не нужен.
GM_ACCESS_CODE=

# --- ИИ-провайдер ---
# gemini | openrouter | opencode | local | mock. Если задан — перекрывает выбор в настройках.
LLM_PROVIDER=
# Провайдер по умолчанию, если в настройках ещё ничего не выбрано
DEFAULT_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENCODE_API_KEY=
OPENCODE_API_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=deepseek-v4-flash
# OpenAI-совместимый сервер (Ollama, LM Studio, vLLM...). Запросы идут С СЕРВЕРА игры.
LOCAL_MODEL_URL=http://localhost:11434/v1
LOCAL_MODEL_KEY=
LOCAL_MODEL_NAME=llama3.1
# Сколько ждать ответа модели, мс
LLM_TIMEOUT_MS=180000

# --- Сервер ---
PORT=3000
DB_PATH=./data/game.db
# За реверс-прокси (nginx, Caddy, Cloudflare) — чтобы лимиты считались по реальному IP
TRUST_PROXY=false
# Публичный адрес (для заголовков OpenRouter)
APP_URL=
# Лимиты: ходов/генераций в минуту с одного IP и новых сессий в час
RATE_LIMIT_PER_MIN=30
SESSIONS_PER_HOUR=30
