{
  "name": "nexus-rpg",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --target=node20 --packages=external --outfile=dist-server/server.mjs",
    "start": "node dist-server/server.mjs",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist dist-server",
    "eval:prompts": "tsx scripts/eval-prompts.ts",
    "build:demo": "vite build --mode demo && cp dist-demo/index.html dist-demo/404.html",
    "dev:demo": "vite --mode demo",
    "balance": "tsx scripts/balance.ts"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "nodemailer": "^10.6.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "d3": "^7.9.0",
    "esbuild": "^0.28.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "sql.js": "^1.16.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^5.1.0"
  },
  "description": "Онлайн-НРИ с ИИ-мастером: соло, мультиплеер и режим сказки",
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "brace-expansion@2": "^2.1.8",
    "proxy-addr": "^2.0.8"
  }
}
